# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

# Database (local MongoDB by default; use your Atlas link when you deploy)
MONGO_URL=mongodb://127.0.0.1:27017/wanderlust

# Any long random text. Required when NODE_ENV=production.
SESSION_SECRET=change-this-to-a-long-random-text

# Cloudinary (image uploads)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Mapbox public token (map on the listing page and location lookup)
MAP_TOKEN=
