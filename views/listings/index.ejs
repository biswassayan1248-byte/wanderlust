<% layout("/layouts/boilerplate") %>

<%
  const icons = {
    "Trending": "fa-fire",
    "Rooms": "fa-bed",
    "Iconic cities": "fa-mountain-city",
    "Mountains": "fa-mountain",
    "Castles": "fa-chess-rook",
    "Amazing pools": "fa-person-swimming",
    "Camping": "fa-campground",
    "Farms": "fa-cow",
    "Arctic": "fa-snowflake"
  };
  const count = allListing.length;
  const isSearch = Boolean(query.q || query.maxPrice);
%>

<% if (!isSearch && !activeCategory) { %>
<section class="hero">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <p class="hero-eyebrow">WANDERLUST</p>
    <h1>Stays worth the journey</h1>
    <p class="hero-lede">Handpicked homes, cabins and villas around the world, chosen for the view as much as the address.</p>

    <form action="/listings" method="get" class="search-box">
      <div class="field">
        <label for="q">Destination</label>
        <input id="q" name="q" type="text" placeholder="Try “Malibu” or “Italy”" value="<%= query.q || '' %>">
      </div>
      <div class="field">
        <label for="maxPrice">Max price / night</label>
        <select id="maxPrice" name="maxPrice">
          <option value="">Any price</option>
          <option value="5000" <%= query.maxPrice === "5000" ? "selected" : "" %>>Under &#8377;5,000</option>
          <option value="15000" <%= query.maxPrice === "15000" ? "selected" : "" %>>Under &#8377;15,000</option>
          <option value="30000" <%= query.maxPrice === "30000" ? "selected" : "" %>>Under &#8377;30,000</option>
        </select>
      </div>
      <button type="submit"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Search</button>
    </form>
  </div>
</section>
<script src="/js/hero.js"></script>
<% } %>

<header class="page-head">
  <h1>
    <% if (isSearch) { %>Search results<% } else { %><%= activeCategory || "Places to stay" %><% } %>
  </h1>
  <p>
    <%= count %> <%= count === 1 ? "place" : "places" %><%= activeCategory ? " in this category" : "" %>
    <% if (query.q) { %> matching &ldquo;<%= query.q %>&rdquo;<% } %>
  </p>
</header>

<nav class="filters" aria-label="Filter by category">
  <% for (let category of categories) { %>
    <a href="/listings?category=<%= encodeURIComponent(category) %>"
       class="chip <%= activeCategory === category ? 'active' : '' %>"
       <%= activeCategory === category ? 'aria-current=page' : '' %>>
      <i class="fa-solid <%= icons[category] || 'fa-house' %>" aria-hidden="true"></i>
      <%= category %>
    </a>
  <% } %>
  <% if (activeCategory || isSearch) { %>
    <a href="/listings" class="chip"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Clear</a>
  <% } %>
</nav>

<% if (count === 0) { %>
  <section class="empty">
    <h2>No places found</h2>
    <p><%= isSearch ? "Try a different destination or a higher price." : (activeCategory ? "Nobody has added a place in " + activeCategory + " yet." : "Nobody has added a place yet.") %></p>
    <a href="/listings/new" class="btn btn-ink">Add your place</a>
  </section>
<% } %>

<div class="stays">
  <% for (let listing of allListing) { %>
    <a href="/listings/<%= listing._id %>" class="stay">
      <div class="stay-photo">
        <img src="<%= listing.image.url %>" alt="<%= listing.title %>" loading="lazy">
        <% if (listing.category) { %><span class="stay-tag"><%= listing.category %></span><% } %>
      </div>
      <h2 class="stay-title"><%= listing.title %></h2>
      <p class="stay-place"><%= [listing.location, listing.country].filter(Boolean).join(", ") %></p>
      <p class="stay-price"><span class="amount">&#8377;<%= (listing.price || 0).toLocaleString("en-IN") %></span> <span class="per">per night</span></p>
    </a>
  <% } %>
</div>
