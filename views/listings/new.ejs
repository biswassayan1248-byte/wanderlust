<% layout("/layouts/boilerplate") %>

<div class="form-page">
  <h1>Add your place</h1>
  <p class="lede">Tell guests what they will find. You can edit any of this later.</p>

  <form action="/listings" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input id="title" name="listing[title]" type="text" class="form-control" required>
      <div class="invalid-feedback">Add a title.</div>
    </div>

    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea id="description" name="listing[description]" rows="5" class="form-control" required></textarea>
      <div class="invalid-feedback">Add a description.</div>
    </div>

    <div class="mb-3">
      <label for="image" class="form-label">Photo</label>
      <input id="image" name="listing[image]" type="file" accept="image/png, image/jpeg, image/webp" class="form-control">
    </div>

    <div class="row">
      <div class="mb-3 col-md-5">
        <label for="price" class="form-label">Price per night (&#8377;)</label>
        <input id="price" name="listing[price]" type="number" min="0" class="form-control" required>
        <div class="invalid-feedback">Add a price.</div>
      </div>

      <div class="mb-3 col-md-7">
        <label for="category" class="form-label">Type of stay</label>
        <select id="category" name="listing[category]" class="form-select">
          <% for (let category of categories) { %>
            <option value="<%= category %>"><%= category %></option>
          <% } %>
        </select>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-md-7">
        <label for="location" class="form-label">City or area</label>
        <input id="location" name="listing[location]" type="text" class="form-control" required>
        <div class="invalid-feedback">Add a city or area.</div>
      </div>

      <div class="mb-3 col-md-5">
        <label for="country" class="form-label">Country</label>
        <input id="country" name="listing[country]" type="text" class="form-control" required>
        <div class="invalid-feedback">Add a country.</div>
      </div>
    </div>

    <div class="form-actions">
      <button class="btn btn-ink">Add listing</button>
      <a href="/listings">Cancel</a>
    </div>
  </form>
</div>
