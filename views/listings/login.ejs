<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
      <div class="col-8 offset-2">

        <h2>Log in to Wanderlust</h2>

              <form action="/user/login" method="post" class="needs-validation" novalidate>

                 <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input name="username" type="text" id="username" class="form-control"  required>
        <div class="valid-feedback">Looks good!</div>
    </div>

 <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input name="password" type="password" id="password" class="form-control"  required>
        <div class="valid-feedback">Looks good!</div>
    </div>
               

             <button class="btn btn-success  mt-3">Login</button>

              </form>
        </div>
        </div>