<% layout("/layouts/boilerplate") %>

<div class="form-page">
  <h1>Edit your listing</h1>
  <p class="lede">Changes appear on your listing as soon as you save.</p>

  <form action="/listings/<%= listing._id %>?_method=PUT" method="post" class="needs-validation" novalidate enctype="multipart/form-data">
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input id="title" name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required>
      <div class="invalid-feedback">Add a title.</div>
    </div>

    <div class="mb-3">
      <label for="description" class="form-label">Description</label>
      <textarea id="description" name="listing[description]" rows="5" class="form-control" required><%= listing.description %></textarea>
      <div class="invalid-feedback">Add a description.</div>
    </div>

    <div class="mb-3">
      <span class="form-label d-block">Current photo</span>
      <img src="<%= listing.image.url %>" alt="Current photo of <%= listing.title %>" style="height: 8rem; border-radius: 12px; object-fit: cover;">
    </div>

    <div class="mb-3">
      <label for="image" class="form-label">Replace photo (optional)</label>
      <input id="image" name="listing[image]" type="file" accept="image/png, image/jpeg, image/webp" class="form-control">
    </div>

    <div class="row">
      <div class="mb-3 col-md-5">
        <label for="price" class="form-label">Price per night (&#8377;)</label>
        <input id="price" name="listing[price]" value="<%= listing.price %>" type="number" min="0" class="form-control" required>
        <div class="invalid-feedback">Add a price.</div>
      </div>

      <div class="mb-3 col-md-7">
        <label for="category" class="form-label">Type of stay</label>
        <select id="category" name="listing[category]" class="form-select">
          <% for (let category of categories) { %>
            <option value="<%= category %>" <%= listing.category === category ? "selected" : "" %>><%= category %></option>
          <% } %>
        </select>
      </div>
    </div>

    <div class="row">
      <div class="mb-3 col-md-7">
        <label for="location" class="form-label">City or area</label>
        <input id="location" name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" required>
        <div class="invalid-feedback">Add a city or area.</div>
      </div>

      <div class="mb-3 col-md-5">
        <label for="country" class="form-label">Country</label>
        <input id="country" name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" required>
        <div class="invalid-feedback">Add a country.</div>
      </div>
    </div>

    <div class="form-actions">
      <button class="btn btn-ink">Save changes</button>
      <a href="/listings/<%= listing._id %>">Cancel</a>
    </div>
  </form>
</div>
