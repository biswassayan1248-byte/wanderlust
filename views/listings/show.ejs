<% layout("/layouts/boilerplate") %>
<%
  const hasCoords = listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2;
  const mapData = {
    token: process.env.MAP_TOKEN || "",
    coords: hasCoords ? listing.geometry.coordinates : null,
    place: [listing.location, listing.country].filter(Boolean).join(", ")
  };
  const ratings = listing.reviews.map((r) => r.rating).filter((r) => typeof r === "number");
  const average = ratings.length ? ratings.reduce((a, b) => a + b, 0) / ratings.length : 0;
  const isOwner = currUser && listing.owner && listing.owner._id.equals(currUser._id);
  const hostName = listing.owner ? listing.owner.username : "Unknown";
%>
<script>
  // "<" is escaped so text from the database can never close this script tag
  const mapData = <%- JSON.stringify(mapData).replace(/</g, "\\u003c") %>;
</script>

<header class="listing-head">
  <h1><%= listing.title %></h1>
  <div class="listing-sub">
    <span><%= mapData.place %></span>
    <% if (ratings.length) { %>
      <span><%= average.toFixed(1) %> average from <%= ratings.length %> review<%= ratings.length === 1 ? "" : "s" %></span>
    <% } else { %>
      <span>No reviews yet</span>
    <% } %>
  </div>
</header>

<div class="hero-photo">
  <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
</div>

<div class="listing-body">
  <div>
    <section class="about">
      <p><%= listing.description %></p>
    </section>

    <section class="reviews" id="reviews">
      <h2>Reviews</h2>

      <% if (currUser) { %>
        <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation review-form">
          <div class="mb-3">
            <label class="form-label d-block">Your rating</label>
            <fieldset class="starability-slot">
              <legend>Rating</legend>
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label">Your review</label>
            <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
            <div class="invalid-feedback">Write a short review before posting.</div>
          </div>
          <button class="btn btn-ink">Post review</button>
        </form>
      <% } else { %>
        <p class="review-summary"><a href="/user/login">Log in</a> to leave a review.</p>
      <% } %>

      <% if (listing.reviews.length > 0) { %>
        <% for (let review of listing.reviews) { %>
          <%
            const name = review.author ? review.author.username : "deleted user";
            const posted = review.createdAt
              ? new Date(review.createdAt).toLocaleDateString("en-IN", { month: "short", year: "numeric" })
              : "";
          %>
          <article class="review">
            <div class="avatar" aria-hidden="true"><%= name.charAt(0).toUpperCase() %></div>
            <div>
              <p class="review-name">@<%= name %><% if (posted) { %><span class="review-date"><%= posted %></span><% } %></p>
              <p class="starability-result" data-rating="<%= review.rating %>">Rated: <%= review.rating %> stars</p>
              <p class="review-text"><%= review.comment %></p>

              <% if (currUser && review.author && review.author._id.equals(currUser._id)) { %>
                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>" method="post">
                  <button class="btn btn-sm btn-outline-rust">Delete review</button>
                </form>
              <% } %>
            </div>
          </article>
        <% } %>
      <% } else { %>
        <p class="review-summary">Nobody has reviewed this place yet.</p>
      <% } %>
    </section>
  </div>

  <aside class="side-panel">
    <p class="price">&#8377;<%= (listing.price || 0).toLocaleString("en-IN") %> <span class="per">per night</span></p>
    <dl class="facts">
      <div><dt>Hosted by</dt><dd>@<%= hostName %></dd></div>
      <div><dt>Where</dt><dd><%= mapData.place %></dd></div>
      <div><dt>Type of stay</dt><dd><%= listing.category %></dd></div>
    </dl>

    <% if (isOwner) { %>
      <div class="panel-actions">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-ink">Edit listing</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
          <button class="btn btn-outline-rust">Delete listing</button>
        </form>
      </div>
    <% } %>
  </aside>
</div>

<section class="map-section">
  <h2>Where you'll be</h2>
  <div id="map"></div>
</section>

<script src="/js/map.js"></script>
